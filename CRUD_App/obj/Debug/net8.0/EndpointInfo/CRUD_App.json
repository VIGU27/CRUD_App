    "/api/articles/filter": {
      "post": {
        "tags": [
          "Articles"
        ],
        "summary": "Filters and sorts articles.",
        "description": "Sorting:\r\n- SortBy: Title or CreatedAt\r\n- SortDir: Asc or Desc\r\n- Defaults to CreatedAt descending\r\n            \r\nFilter by Status. (All/Draft/Published/Unpublished)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArticleFilterRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ArticleFilterRequest"
